{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://raw.githubusercontent.com/rmcgazo/infovis-assignment2/main/emissions_gva.csv",
    "format": {"type": "csv"}
  },
  "title": {
    "text": "Emissions per €1 million of economic output",
    "anchor": "middle",
    "fontSize": 18
  },
  "width": 400,
  "height": 500,
  "params": [
    {
      "name": "year",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2009,
        "max": 2024,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "transform": [
    {"filter": "datum.Year == year"},
    {
      "calculate": "datum.Section == 'A' ? 'Agriculture' : datum.Section == 'H' ? 'Transport' : indexof(['B','C','D','E','F'], datum.Section) >= 0 ? 'Industry and energy' : 'Services'",
      "as": "Group"
    }
  ],
  "mark": "bar",
  "encoding": {
    "y": {
      "field": "Sector",
      "type": "nominal",
      "sort": "-x",
      "axis": {"title": null, "labelLimit": 220}
    },
    "x": {
      "field": "Intensity",
      "type": "quantitative",
      "axis": {"title": "Tonnes CO2e per €1 million of GVA"}
    },
    "color": {
      "field": "Group",
      "type": "nominal",
      "scale": {
        "domain": [
          "Agriculture",
          "Transport",
          "Industry and energy",
          "Services"
        ],
        "range": ["#009E73", "#E69F00", "#0072B2", "#CC79A7"]
      },
      "legend": {"title": "Sector type"}
    },
    "tooltip": [
      {"field": "Sector", "type": "nominal"},
      {
        "field": "Intensity",
        "type": "quantitative",
        "format": ",.0f",
        "title": "Tonnes CO2e per €m"
      },
      {"field": "Emissions", "type": "quantitative", "format": ",.0f"},
      {"field": "GVA", "type": "quantitative", "format": ",.0f"}
    ]
  },
  "config": {
    "axis": {"titleFontSize": 14, "labelFontSize": 12},
    "legend": {
      "orient": "bottom-right",
      "titleFontSize": 13,
      "labelFontSize": 12
    }
  }
}