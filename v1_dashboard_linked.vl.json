{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://raw.githubusercontent.com/rmcgazo/infovis-assignment2/main/emissions_gva.csv",
    "format": {"type": "csv"}
  },
  "title": {
    "text": "Which sectors of Ireland's economy emit the most for what they produce?",
    "subtitle": "Drag the slider to change year. Click a sector to highlight it in both charts (shift-click to add more, double-click to clear).",
    "anchor": "middle",
    "fontSize": 20,
    "offset": 20
  },
  "params": [
    {
      "name": "year",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2009,
        "max": 2024,
        "step": 1,
        "name": "Year: "
      }
    },
    {
      "name": "pick",
      "select": {"type": "point", "fields": ["Sector"]},
      "views": ["scatter", "bar"]
    }
  ],
  "transform": [
    {"filter": "datum.Year == year"},
    {
      "calculate": "datum.Section == 'A' ? 'Agriculture' : datum.Section == 'H' ? 'Transport' : indexof(['B','C','D','E','F'], datum.Section) >= 0 ? 'Industry and energy' : 'Services'",
      "as": "Group"
    }
  ],
  "hconcat": [
    {
      "name": "scatter",
      "title": "Economic output vs emissions",
      "width": 450,
      "height": 450,
      "mark": {"type": "circle", "size": 120, "opacity": 1},
      "encoding": {
        "x": {
          "field": "GVA",
          "type": "quantitative",
          "scale": {"type": "log", "domain": [300, 300000]},
          "axis": {
            "title": "Economic output (GVA, € million, log scale)",
            "values": [300, 1000, 3000, 10000, 30000, 100000, 300000],
            "format": ",.0f"
          }
        },
        "y": {
          "field": "Emissions",
          "type": "quantitative",
          "scale": {"type": "log", "domain": [10, 40000]},
          "axis": {
            "title": "Emissions (thousand tonnes CO2e, log scale)",
            "values": [10, 30, 100, 300, 1000, 3000, 10000, 30000],
            "format": ",.0f"
          }
        },
        "opacity": {"condition": {"param": "pick", "value": 1}, "value": 0.15},
        "color": {
          "field": "Group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Agriculture",
              "Transport",
              "Industry and energy",
              "Services"
            ],
            "range": ["#009E73", "#E69F00", "#0072B2", "#CC79A7"]
          }
        },
        "tooltip": [
          {"field": "Sector", "type": "nominal"},
          {"field": "Emissions", "type": "quantitative", "format": ",.0f"},
          {"field": "GVA", "type": "quantitative", "format": ",.0f"},
          {
            "field": "Intensity",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Tonnes CO2e per €m"
          }
        ]
      }
    },
    {
      "name": "bar",
      "title": "Emissions per €1 million of output",
      "width": 350,
      "height": 450,
      "mark": "bar",
      "encoding": {
        "y": {
          "field": "Sector",
          "type": "nominal",
          "sort": "-x",
          "axis": {"title": null}
        },
        "x": {
          "field": "Intensity",
          "type": "quantitative",
          "axis": {"title": "Tonnes CO2e per €1 million of GVA"}
        },
        "opacity": {"condition": {"param": "pick", "value": 1}, "value": 0.15},
        "color": {
          "field": "Group",
          "type": "nominal",
          "scale": {
            "domain": [
              "Agriculture",
              "Transport",
              "Industry and energy",
              "Services"
            ],
            "range": ["#009E73", "#E69F00", "#0072B2", "#CC79A7"]
          }
        },
        "tooltip": [
          {"field": "Sector", "type": "nominal"},
          {
            "field": "Intensity",
            "type": "quantitative",
            "format": ",.0f",
            "title": "Tonnes CO2e per €m"
          },
          {"field": "Emissions", "type": "quantitative", "format": ",.0f"},
          {"field": "GVA", "type": "quantitative", "format": ",.0f"}
        ]
      }
    }
  ],
  "resolve": {"scale": {"color": "shared"}},
  "config": {
    "axis": {"titleFontSize": 13, "labelFontSize": 12},
    "title": {"fontSize": 16},
    "legend": {
      "orient": "bottom",
      "direction": "horizontal",
      "title": null,
      "labelFontSize": 13
    }
  }
}