{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "data": {
    "url": "https://raw.githubusercontent.com/rmcgazo/infovis-assignment2/main/emissions_gva.csv",
    "format": {
      "type": "csv",
      "parse": {
        "Year": "number",
        "Emissions": "number",
        "GVA": "number",
        "Intensity": "number",
        "CO2": "number",
        "Methane": "number",
        "Nitrous oxide": "number",
        "Fluorinated gases": "number"
      }
    }
  },
  "title": {
    "text": "Which sectors of Ireland's economy emit the most for what they produce?",
    "subtitle": [
      "Use the controls at the bottom to change the year and what the bar chart ranks. Click a sector in any chart to highlight it everywhere.",
      "Source: CSO High Value Datasets EAA17 (greenhouse gas emissions) and NA033 (gross value added). Households are not included as they have no economic output."
    ],
    "anchor": "middle",
    "fontSize": 22,
    "subtitleFontSize": 13,
    "subtitlePadding": 8,
    "offset": 16
  },
  "params": [
    {
      "name": "year",
      "value": 2024,
      "bind": {
        "input": "range",
        "min": 2009,
        "max": 2024,
        "step": 1,
        "name": "Year: "
      }
    },
    {
      "name": "metric",
      "value": "Intensity",
      "bind": {
        "input": "select",
        "options": ["Intensity", "Emissions", "GVA"],
        "labels": [
          "Emissions per €1 million of output",
          "Total emissions",
          "Economic output (GVA)"
        ],
        "name": "Rank sectors by: "
      }
    },
    {
      "name": "pick",
      "select": {"type": "point", "fields": ["Sector"]},
      "views": ["scatter", "bar", "lines", "gas"]
    }
  ],
  "transform": [
    {
      "calculate": "datum.Section == 'A' ? 'Agriculture' : datum.Section == 'H' ? 'Transport' : indexof(['B','C','D','E','F'], datum.Section) >= 0 ? 'Industry and energy' : 'Services'",
      "as": "Group"
    }
  ],
  "vconcat": [
    {
      "hconcat": [
        {
          "name": "scatter",
          "title": {
            "text": {"expr": "'Economic output vs emissions, ' + year"},
            "subtitle": "Higher and further left = more emissions for less output"
          },
          "width": 450,
          "height": 430,
          "transform": [{"filter": "datum.Year == year"}],
          "mark": {
            "type": "circle",
            "size": 140,
            "opacity": 1,
            "stroke": "white",
            "strokeWidth": 1,
            "cursor": "pointer"
          },
          "encoding": {
            "x": {
              "field": "GVA",
              "type": "quantitative",
              "scale": {"type": "log", "domain": [300, 300000]},
              "axis": {
                "title": "Economic output (GVA, € million, log scale)",
                "values": [300, 1000, 3000, 10000, 30000, 100000, 300000],
                "format": ",.0f"
              }
            },
            "y": {
              "field": "Emissions",
              "type": "quantitative",
              "scale": {"type": "log", "domain": [10, 40000]},
              "axis": {
                "title": "Emissions (thousand tonnes CO₂e, log scale)",
                "values": [10, 30, 100, 300, 1000, 3000, 10000, 30000],
                "format": ",.0f"
              }
            },
            "color": {
              "field": "Group",
              "type": "nominal",
              "scale": {
                "domain": [
                  "Agriculture",
                  "Transport",
                  "Industry and energy",
                  "Services"
                ],
                "range": ["#009E73", "#E69F00", "#0072B2", "#CC79A7"]
              },
              "legend": {
                "title": "Sector type",
                "orient": "top",
                "direction": "horizontal"
              }
            },
            "opacity": {
              "condition": {"param": "pick", "value": 1},
              "value": 0.15
            },
            "tooltip": [
              {"field": "Sector", "type": "nominal"},
              {"field": "Year", "type": "quantitative", "format": "d"},
              {
                "field": "Emissions",
                "type": "quantitative",
                "format": ",.0f",
                "title": "Emissions (thousand tonnes CO₂e)"
              },
              {
                "field": "GVA",
                "type": "quantitative",
                "format": ",.0f",
                "title": "Output (GVA, € million)"
              },
              {
                "field": "Intensity",
                "type": "quantitative",
                "format": ",.0f",
                "title": "Tonnes CO₂e per €1 million of output"
              }
            ]
          }
        },
        {
          "title": {
            "text": {
              "expr": "(metric == 'Emissions' ? 'Total emissions, ' : metric == 'GVA' ? 'Economic output, ' : 'Emissions per €1 million of output, ') + year"
            },
            "subtitle": {
              "expr": "metric == 'Intensity' ? \"Manufacturing's fall after 2015 is mainly multinational accounting, not lower emissions\" : metric == 'Emissions' ? 'Thousand tonnes CO₂e' : 'Gross value added, € million'"
            }
          },
          "width": 340,
          "height": 430,
          "transform": [
            {"filter": "datum.Year == year"},
            {
              "calculate": "metric == 'Emissions' ? datum.Emissions : metric == 'GVA' ? datum.GVA : datum.Intensity",
              "as": "Value"
            }
          ],
          "encoding": {
            "y": {
              "field": "Sector",
              "type": "nominal",
              "sort": "-x",
              "axis": {"title": null, "ticks": false, "labelPadding": 6}
            },
            "x": {
              "field": "Value",
              "type": "quantitative",
              "aggregate": "max",
              "stack": null,
              "axis": {
                "title": {
                  "expr": "metric == 'Emissions' ? 'Emissions (thousand tonnes CO₂e)' : metric == 'GVA' ? 'Output (GVA, € million)' : 'Tonnes CO₂e per €1 million of output (GVA)'"
                },
                "format": ",.0f"
              }
            },
            "tooltip": [
              {"field": "Sector", "type": "nominal"},
              {"field": "Year", "type": "quantitative", "format": "d"},
              {
                "field": "Intensity",
                "type": "quantitative",
                "format": ",.0f",
                "title": "Tonnes CO₂e per €1 million of output"
              },
              {
                "field": "Emissions",
                "type": "quantitative",
                "format": ",.0f",
                "title": "Emissions (thousand tonnes CO₂e)"
              },
              {
                "field": "GVA",
                "type": "quantitative",
                "format": ",.0f",
                "title": "Output (GVA, € million)"
              }
            ]
          },
          "layer": [
            {
              "name": "bar",
              "mark": {"type": "bar", "cursor": "pointer"},
              "encoding": {
                "color": {
                  "field": "Group",
                  "type": "nominal",
                  "scale": {
                    "domain": [
                      "Agriculture",
                      "Transport",
                      "Industry and energy",
                      "Services"
                    ],
                    "range": ["#009E73", "#E69F00", "#0072B2", "#CC79A7"]
                  },
                  "legend": {
                    "title": "Sector type",
                    "orient": "top",
                    "direction": "horizontal"
                  }
                },
                "opacity": {
                  "condition": {"param": "pick", "value": 1},
                  "value": 0.15
                }
              }
            },
            {
              "mark": {
                "type": "text",
                "align": "left",
                "dx": 4,
                "fontSize": 11,
                "color": "#333"
              },
              "encoding": {
                "text": {
                  "field": "Value",
                  "type": "quantitative",
                  "format": ",.0f"
                },
                "opacity": {
                  "condition": {"param": "pick", "value": 1},
                  "value": 0.25
                }
              }
            }
          ]
        }
      ]
    },
    {
      "hconcat": [
        {
          "title": {
            "text": "Emissions over time, 2009 to 2024",
            "subtitle": "Dashed line marks the year selected on the slider"
          },
          "width": 450,
          "height": 300,
          "layer": [
            {
              "name": "lines",
              "mark": {"type": "line", "strokeWidth": 2.5, "cursor": "pointer"},
              "encoding": {
                "x": {
                  "field": "Year",
                  "type": "quantitative",
                  "scale": {"domain": [2009, 2024], "nice": false},
                  "axis": {
                    "title": null,
                    "format": "d",
                    "values": [2009, 2012, 2015, 2018, 2021, 2024],
                    "labelAngle": 0
                  }
                },
                "y": {
                  "field": "Emissions",
                  "type": "quantitative",
                  "scale": {"type": "log", "domain": [10, 40000]},
                  "axis": {
                    "title": "Emissions (thousand tonnes CO₂e, log scale)",
                    "values": [10, 100, 1000, 10000],
                    "format": ",.0f"
                  }
                },
                "detail": {"field": "Sector", "type": "nominal"},
                "color": {
                  "field": "Group",
                  "type": "nominal",
                  "scale": {
                    "domain": [
                      "Agriculture",
                      "Transport",
                      "Industry and energy",
                      "Services"
                    ],
                    "range": ["#009E73", "#E69F00", "#0072B2", "#CC79A7"]
                  },
                  "legend": null
                },
                "opacity": {
                  "condition": {"param": "pick", "value": 1},
                  "value": 0.12
                },
                "tooltip": [
                  {"field": "Sector", "type": "nominal"},
                  {"field": "Year", "type": "quantitative", "format": "d"},
                  {
                    "field": "Emissions",
                    "type": "quantitative",
                    "format": ",.0f",
                    "title": "Emissions (thousand tonnes CO₂e)"
                  }
                ]
              }
            },
            {
              "transform": [{"filter": "datum.Year == year"}],
              "mark": {
                "type": "rule",
                "color": "black",
                "strokeDash": [4, 4],
                "strokeWidth": 1.5
              },
              "encoding": {"x": {"field": "Year", "type": "quantitative"}}
            }
          ]
        },
        {
          "name": "gas",
          "title": {
            "text": {"expr": "'What each sector emits, ' + year"},
            "subtitle": "Share of each sector's emissions by gas, sorted by total emissions"
          },
          "width": 340,
          "height": 300,
          "transform": [
            {"filter": "datum.Year == year"},
            {
              "fold": ["CO2", "Methane", "Nitrous oxide", "Fluorinated gases"],
              "as": ["Gas", "Amount"]
            },
            {
              "calculate": "datum.Amount / datum.Emissions * 100",
              "as": "Share"
            },
            {
              "calculate": "datum.Gas == 'CO2' ? 1 : datum.Gas == 'Methane' ? 2 : datum.Gas == 'Nitrous oxide' ? 3 : 4",
              "as": "GasOrder"
            }
          ],
          "mark": {"type": "bar", "cursor": "pointer"},
          "encoding": {
            "y": {
              "field": "Sector",
              "type": "nominal",
              "sort": {
                "field": "Emissions",
                "op": "max",
                "order": "descending"
              },
              "axis": {"title": null, "ticks": false, "labelPadding": 6}
            },
            "x": {
              "field": "Amount",
              "type": "quantitative",
              "stack": "normalize",
              "axis": {
                "title": "Share of the sector's emissions",
                "format": ".0%",
                "values": [0, 0.25, 0.5, 0.75, 1]
              }
            },
            "color": {
              "field": "Gas",
              "type": "nominal",
              "scale": {
                "domain": [
                  "CO2",
                  "Methane",
                  "Nitrous oxide",
                  "Fluorinated gases"
                ],
                "range": ["#4D4D4D", "#A0522D", "#D9B88F", "#C7D3E0"]
              },
              "legend": {
                "title": "Gas",
                "orient": "bottom",
                "direction": "horizontal",
                "labelExpr": "datum.label == 'CO2' ? 'CO₂' : datum.label"
              }
            },
            "order": {"field": "GasOrder", "type": "quantitative"},
            "opacity": {
              "condition": {"param": "pick", "value": 1},
              "value": 0.15
            },
            "tooltip": [
              {"field": "Sector", "type": "nominal"},
              {"field": "Gas", "type": "nominal"},
              {
                "field": "Share",
                "type": "quantitative",
                "format": ".1f",
                "title": "Share of sector's emissions (%)"
              },
              {
                "field": "Amount",
                "type": "quantitative",
                "format": ",.0f",
                "title": "Emissions (thousand tonnes CO₂e)"
              }
            ]
          }
        }
      ],
      "resolve": {"scale": {"color": "independent"}}
    }
  ],
  "config": {
    "font": "Arial",
    "axis": {
      "titleFontSize": 13,
      "labelFontSize": 12,
      "titleColor": "#333",
      "labelColor": "#333"
    },
    "title": {"fontSize": 16, "subtitleFontSize": 12, "subtitleColor": "#555"},
    "legend": {
      "title": null,
      "labelFontSize": 13,
      "symbolSize": 140,
      "titleFontSize": 13
    },
    "view": {"stroke": null}
  },
  "resolve": {"scale": {"color": "independent"}}
}